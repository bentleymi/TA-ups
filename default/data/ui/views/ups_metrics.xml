<dashboard version="1.1" theme="light">
  <label>TA-ups Metrics</label>
  <description> Index-time metrics over index=metrics (sourcetype ups:metrics); series prefixed 'ups.'.</description>
  <row>
    <panel type="html">
      <html><![CDATA[<div style="border:1px solid #cc7a00;background:#fff7ea;border-radius:6px;padding:10px 14px;display:flex;flex-wrap:wrap;align-items:center;gap:12px">
<span style="font-weight:700;color:#b35c00">Commercial Use</span>
<span>Commercial or production use of TA-ups requires a paid license. Evaluation, personal, and lab use is free. See the BentleyPC Commercial License for full terms.</span>
<a href="https://bentleypc.com/TA-TA-ups/" target="_blank" rel="noopener" style="background:#cc7a00;color:#fff;padding:7px 16px;border-radius:5px;font-weight:700;text-decoration:none">Buy License</a>
<a href="https://bentleypc.com/TA-TA-ups/LICENSE.html" target="_blank" rel="noopener" style="color:#b35c00;font-weight:600;text-decoration:underline">License &amp; Terms</a>
</div>]]></html>
    </panel>
  </row>
  <row>
    <panel>
      <title>All ups.* series (device count + per-device state)</title>
      <chart>
        <search>
          <query>| mstats avg("ups.*") as "v*" where index=metrics by metric_name span=5m
| rename v* as "ups.*"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Battery charge (%) per device</title>
      <chart>
        <search>
          <query>| mstats avg("ups.*_battery_charge") as "v*" where index=metrics by metric_name span=5m
| rename v* as "ups.*_battery_charge"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Load (%) per device</title>
      <chart>
        <search>
          <query>| mstats avg("ups.*_load") as "v*" where index=metrics by metric_name span=5m
| rename v* as "ups.*_load"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Voltages (per device)</title>
      <chart>
        <search>
          <query>| mstats avg("ups.*voltage") as "v*" where index=metrics by metric_name span=5m
| rename v* as "ups.*voltage"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>On-battery flag (1=on battery)</title>
      <chart>
        <search>
          <query>| mstats avg("ups.*_on_battery") as "v*" where index=metrics by metric_name span=5m
| rename v* as "ups.*_on_battery"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
</dashboard>
